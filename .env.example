NODE_ENV=production
PORT=3000
APP_NAME=my-school

# Runtime only — set in Easypanel Environment (not Build Args)
DATABASE_URL="postgres://postgres:YOUR_PASSWORD@amctag_db_myschool:5432/amctag?sslmode=disable"

JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting (per IP)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=5

# CORS — localhost + same-host (Swagger on Easypanel) allowed by default
CORS_ALLOW_LOCALHOST=true
CORS_ALLOW_SAME_HOST=true
# Optional: public app URL (also added to allowed origins)
# APP_PUBLIC_URL=https://amctag-my-school.38f0fz.easypanel.host
# Optional extra origins (comma-separated), e.g. mobile/web frontend
# CORS_ORIGINS=https://your-frontend.com

# Email (for parent change-password OTP)
MAIL_HOST=mail.amcserver.com
MAIL_PORT=587
MAIL_USERNAME=teamsdeveloper@amcserver.com
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=teamsdeveloper@amcserver.com
MAIL_FROM_NAME=RAE Pathways
OTP_EXPIRES_IN=10m
# If auth fails with 535, verify username/password in Easypanel.
# Some servers need port 465 + MAIL_ENCRYPTION=ssl instead of 587.

# Nixpacks build settings (add in Easypanel Environment if build still fails)
NIXPACKS_NODE_VERSION=22.12.0
NIXPACKS_BUILD_CMD=npm run build
NIXPACKS_START_CMD=npm run start:prod
