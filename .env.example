NODE_ENV=production
PORT=3000
APP_NAME=my-school

# Runtime only — set in Easypanel Environment (not Build Args)
# On EasyPanel keep the internal Docker hostname:
# DATABASE_URL="postgres://postgres:YOUR_PASSWORD@amctag_db_myschool:5432/amctag?sslmode=disable"
# On your PC use the public database host and published port (5433), for example:
# DATABASE_URL="postgres://postgres:YOUR_PASSWORD@amctag-db-myschool.38f0fz.easypanel.host:5433/amctag?sslmode=disable"
DATABASE_URL="postgres://postgres:YOUR_PASSWORD@amctag_db_myschool:5432/amctag?sslmode=disable"

JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_RESET_EXPIRES_IN=15m

# CORS — localhost + same-host (Swagger on Easypanel) allowed by default
CORS_ALLOW_LOCALHOST=true
CORS_ALLOW_SAME_HOST=true
# Optional: public app URL (also added to allowed origins)
# APP_PUBLIC_URL=https://amctag-my-school.38f0fz.easypanel.host
# Optional extra origins (comma-separated), e.g. mobile/web frontend
# CORS_ORIGINS=https://your-frontend.com

# Email (for parent change-password OTP)
# Use port 465 for ssl (recommended for mail.amcserver.com)
MAIL_HOST=mail.amcserver.com
MAIL_PORT=465
MAIL_USERNAME=teamsdeveloper@amcserver.com
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=teamsdeveloper@amcserver.com
MAIL_FROM_NAME=RAE Pathways
OTP_EXPIRES_IN=10m
# Alternative: MAIL_PORT=587 with MAIL_ENCRYPTION=tls
# Test locally: npm run mail:test

# Firebase Cloud Messaging (one token per person in fcm_tokens)
# Paste the Firebase service-account JSON as ONE LINE (EasyPanel / .env cannot use real multiline JSON).
# Firebase Console → Project settings → Service accounts → Generate new private key
# Put the real JSON in EasyPanel Environment and in local .env — never commit the private_key.
FCM_PROJECT_ID=koi-beirut
FCM_CREDENTIALS_JSON='{"type":"service_account","project_id":"koi-beirut","private_key_id":"YOUR_PRIVATE_KEY_ID","private_key":"-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-xxxxx@koi-beirut.iam.gserviceaccount.com","client_id":"YOUR_CLIENT_ID","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40koi-beirut.iam.gserviceaccount.com","universe_domain":"googleapis.com"}'

# Nixpacks build settings (add in Easypanel Environment if build still fails)
NIXPACKS_NODE_VERSION=22.12.0
NIXPACKS_BUILD_CMD=npm run build
NIXPACKS_START_CMD=npm run start:prod

# Seed (manual only — NOT run on normal deploy)
# Production: use only `npx prisma migrate deploy` (start:prod already does this).
# Full seed (empty DB only, or SEED_FORCE=true to wipe dev DB):
#   node dist/database/seed/seed.js
# Fake/demo data (safe — does NOT delete existing rows):
#   node dist/database/seed/seed-fake-data.js
#   npm run seed:fake



MAIL_HOST=mail.amcserver.com
MAIL_PORT=587
MAIL_USERNAME=teamsdeveloper@amcserver.com
MAIL_PASSWORD=tag.amc.2013
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=teamsdeveloper@amcserver.com
