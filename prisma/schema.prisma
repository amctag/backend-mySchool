generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model School {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  sessionId String?  @unique @map("session_id") @db.Uuid
  refreshTokenHash String? @unique @map("refresh_token_hash") @db.VarChar(64)
  refreshExpiresAt DateTime? @map("refresh_expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  persons       Person[]
  years         Year[]
  stages        Stage[]
  sectionTitles SectionTitle[]
  sections      Section[]
  courses       Course[]
  days          Day[]
  sessions      Session[]
  teacherSchools TeacherSchool[]
  details        SchoolDetail?
  notices        Notice[]
  albums         Album[]
  grades         Grade[]
  gradeForms     GradeForm[]
  gradeTypes     GradeType[]

  @@map("school")
}

model Person {
  id             Int       @id @default(autoincrement())
  schoolId       Int?      @map("school_id")
  registerId     Int?      @map("register_id")
  username       String    @db.VarChar(100)
  password       String    @db.VarChar(255)
  firstName      String    @map("first_name") @db.VarChar(100)
  middleName     String    @map("middle_name") @db.VarChar(100)
  lastName       String    @map("last_name") @db.VarChar(100)
  email          String?   @unique @db.VarChar(255)
  phoneNumber    String?   @map("phone_number") @db.VarChar(50)
  landline       String?   @db.VarChar(50)
  urgentNumber   String?   @map("urgent_number") @db.VarChar(50)
  address        String?   @db.Text
  birthday       DateTime? @db.Date
  gender         Int?      @db.SmallInt
  picture        String?   @db.VarChar(255)
  status         Boolean   @default(true)
  identityNumber String?   @unique @map("identity_number") @db.VarChar(50)
  nationalityId  Int?      @map("nationality_id")
  governorateId  Int?      @map("governorate_id")
  regionId       Int?      @map("region_id")
  village        String?   @db.VarChar(255)
  placeOfBirth   String?   @map("place_of_birth") @db.VarChar(255)
  bloodTypeId    Int?      @map("blood_type_id")
  identityTypeId Int?      @map("identity_type_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  school                School?                @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  nationality           Nationality?           @relation(fields: [nationalityId], references: [id], onDelete: SetNull)
  governorate           Governorate?           @relation(fields: [governorateId], references: [id], onDelete: SetNull)
  region                Region?                @relation(fields: [regionId], references: [id], onDelete: SetNull)
  bloodType             BloodType?             @relation(fields: [bloodTypeId], references: [id], onDelete: SetNull)
  teacher               Teacher?
  parent                Parent?
  student               Student?
  weeklyScheduleDetails WeeklyScheduleDetail[]
  registrations         Registration[]
  parentSessions        ParentSession[]
  passwordChangeOtp     PasswordChangeOtp?
  passwordResetOtp      PasswordResetOtp?
  announcements         Announcement[]
  activities            Activity[]
  attendances           Attendance[]
  attendanceReasons     AttendanceReason[]
  notices               Notice[]
  noticeTypes           NoticeType[]
  agendas               Agenda[]
  examSchedules         ExamSchedule[]
  grades                Grade[]

  @@unique([schoolId, username])
  @@index([schoolId])
  @@index([firstName, lastName])
  @@map("persons")
}

model Teacher {
  id        Int      @id @default(autoincrement())
  personId  Int      @unique @map("person_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  person  Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  schools TeacherSchool[]
  teaches Teach[]

  @@map("teachers")
}

model TeacherSchool {
  id        Int      @id @default(autoincrement())
  teacherId Int      @map("teacher_id")
  schoolId  Int      @map("school_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([teacherId, schoolId])
  @@map("teacher_schools")
}

model Parent {
  id           Int      @id @default(autoincrement())
  personId     Int      @unique @map("person_id")
  currentJobId Int?     @map("current_job_id")
  description  String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  person     Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  currentJob ParentJob? @relation(fields: [currentJobId], references: [id], onDelete: SetNull)
  students   Student[]

  @@map("parents")
}

model Nationality {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  persons Person[]

  @@map("nationalities")
}

model BloodType {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  persons Person[]

  @@map("blood_types")
}

model Governorate {
  id        Int      @id @default(autoincrement())
  code      Int      @unique
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  regions Region[]
  persons Person[]

  @@map("governorates")
}

model Region {
  id            Int      @id @default(autoincrement())
  governorateId Int      @map("governorate_id")
  name          String   @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  governorate Governorate @relation(fields: [governorateId], references: [id], onDelete: Cascade)
  persons     Person[]

  @@unique([governorateId, name])
  @@index([governorateId])
  @@map("regions")
}

model ParentJob {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parents Parent[]

  @@map("parent_jobs")
}

model Student {
  id           Int      @id @default(autoincrement())
  personId     Int      @unique @map("person_id")
  parentId     Int?     @map("parent_id")
  motherName   String?  @map("mother_name") @db.VarChar(255)
  motherFamily String?  @map("mother_family") @db.VarChar(255)
  motherPhone  String?  @map("mother_phone") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  person        Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  parent        Parent?        @relation(fields: [parentId], references: [id], onDelete: SetNull)
  registrations Registration[]
  attendanceDetails AttendanceDetail[]
  noticeStudents    NoticeStudent[]

  @@index([parentId])
  @@index([parentId, id])
  @@map("students")
}

model Year {
  id        Int      @id @default(autoincrement())
  schoolId  Int      @map("school_id")
  title     String   @db.VarChar(20)
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  sections     Section[]
  classCourses ClassCourse[]
  teaches      Teach[]
  activities    Activity[]
  albums        Album[]
  examSchedules ExamSchedule[]
  gradeForms    GradeForm[]

  @@unique([schoolId, title])
  @@index([schoolId, isCurrent])
  @@map("years")
}

model Stage {
  id        Int      @id @default(autoincrement())
  schoolId  Int      @map("school_id")
  title     String   @db.VarChar(100)
  position  Int      @default(0) @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classes Class[]

  @@map("stages")
}

model Class {
  id         Int      @id @default(autoincrement())
  className  String   @map("class_name") @db.VarChar(100)
  stageId    Int      @map("stage_id")
  classLevel Int      @map("class_level") @db.SmallInt
  position   Int      @default(0) @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  stage        Stage         @relation(fields: [stageId], references: [id], onDelete: Restrict)
  sections     Section[]
  classCourses ClassCourse[]
  announcementSections AnnouncementSection[]
  examSchedules        ExamSchedule[]
  gradeFormClasses     GradeFormClass[]

  @@map("classes")
}

model SectionTitle {
  id        Int      @id @default(autoincrement())
  schoolId  Int      @map("school_id")
  title     String   @db.VarChar(100)
  status    Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  sections Section[]

  @@unique([schoolId, title])
  @@map("section_titles")
}

model Section {
  id             Int      @id @default(autoincrement())
  schoolId       Int      @map("school_id")
  classId        Int      @map("class_id")
  sectionTitleId Int      @map("section_title_id")
  yearId         Int      @map("year_id")
  status         Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school           School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  class            Class            @relation(fields: [classId], references: [id], onDelete: Restrict)
  sectionTitle     SectionTitle     @relation(fields: [sectionTitleId], references: [id], onDelete: Restrict)
  year             Year             @relation(fields: [yearId], references: [id], onDelete: Restrict)
  teaches          Teach[]
  weeklySchedules  WeeklySchedule[]
  registrations    Registration[]
  announcementSections AnnouncementSection[]
  attendances      Attendance[]
  noticeSections   NoticeSection[]
  agendaSections   AgendaSection[]
  grades           Grade[]

  @@index([schoolId, yearId])
  @@index([classId, yearId])
  @@map("sections")
}

model Course {
  id          Int      @id @default(autoincrement())
  schoolId    Int      @map("school_id")
  title       String   @db.VarChar(255)
  description String?  @db.Text
  parentId    Int?     @map("parent_id")
  status      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  parent                Course?                @relation("CourseHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children              Course[]               @relation("CourseHierarchy")
  classCourses          ClassCourse[]
  teaches               Teach[]
  weeklyScheduleDetails WeeklyScheduleDetail[]
  agendas               Agenda[]
  examScheduleDetails   ExamScheduleDetail[]
  grades                Grade[]

  @@map("courses")
}

model ClassCourse {
  id            Int      @id @default(autoincrement())
  classId       Int      @map("class_id")
  courseId      Int      @map("course_id")
  yearId        Int      @map("year_id")
  coefficient   Decimal  @default(1.0) @db.Decimal(4, 2)
  numberOfHours Int?     @map("number_of_hours") @db.SmallInt
  calculation   Boolean  @default(true)
  position      Int      @default(0) @db.SmallInt
  abstract      Boolean  @default(false)
  percentage    Decimal? @db.Decimal(5, 2)
  status        Boolean  @default(true)
  visible       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  class  Class  @relation(fields: [classId], references: [id], onDelete: Restrict)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  year   Year   @relation(fields: [yearId], references: [id], onDelete: Restrict)

  @@map("class_courses")
}

model Teach {
  id        Int      @id @default(autoincrement())
  teacherId Int      @map("teacher_id")
  sectionId Int      @map("section_id")
  courseId  Int      @map("course_id")
  yearId    Int      @map("year_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  year    Year    @relation(fields: [yearId], references: [id], onDelete: Restrict)

  @@map("teach")
}

model Day {
  id        Int      @id @default(autoincrement())
  schoolId  Int      @map("school_id")
  dayName   String   @map("day_name") @db.VarChar(50)
  position  Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  weeklyScheduleDetails WeeklyScheduleDetail[]

  @@map("days")
}

model Session {
  id          Int      @id @default(autoincrement())
  schoolId    Int      @map("school_id")
  sessionName String   @map("session_name") @db.VarChar(50)
  position    Int      @default(0) @db.SmallInt
  status      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  weeklyScheduleDetails WeeklyScheduleDetail[]

  @@map("sessions")
}

model WeeklySchedule {
  id        Int      @id @default(autoincrement())
  sectionId Int      @map("section_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  section Section                @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  details WeeklyScheduleDetail[]

  @@map("weekly_schedules")
}

model WeeklyScheduleDetail {
  id         Int      @id @default(autoincrement())
  scheduleId Int      @map("schedule_id")
  dayId      Int      @map("day_id")
  sessionId  Int      @map("session_id")
  courseId   Int      @map("course_id")
  personId   Int?     @map("person_id")
  note       String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  schedule WeeklySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  day      Day              @relation(fields: [dayId], references: [id], onDelete: Restrict)
  session  Session          @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  course   Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  person   Person?          @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@map("weekly_schedule_details")
}

model Registration {
  id        Int      @id @default(autoincrement())
  sectionId Int      @map("section_id")
  studentId Int      @map("student_id")
  personId  Int      @map("person_id")
  status    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  section Section @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Restrict)
  gradeDetails GradeDetail[]

  @@index([studentId, status])
  @@index([sectionId, status])
  @@map("registrations")
}

model ParentSession {
  id               String   @id @default(uuid()) @db.Uuid
  personId         Int      @map("person_id")
  refreshTokenHash String   @unique @map("refresh_token_hash") @db.VarChar(64)
  refreshExpiresAt DateTime @map("refresh_expires_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId])
  @@map("parent_sessions")
}

model PasswordChangeOtp {
  id        String   @id @default(uuid()) @db.Uuid
  personId  Int      @unique @map("person_id")
  otpHash   String   @map("otp_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("password_change_otps")
}

model PasswordResetOtp {
  id        String   @id @default(uuid()) @db.Uuid
  personId  Int      @unique @map("person_id")
  otpHash   String   @map("otp_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("password_reset_otps")
}

enum AnnouncementAudience {
  parent
  student
  teacher
}

model Announcement {
  id          Int       @id @default(autoincrement())
  title       String?   @db.VarChar(255)
  content     String    @db.Text
  hits        Int       @default(0)
  personId    Int       @map("person_id")
  publishDate DateTime  @map("publish_date") @db.Date
  publishTime DateTime  @map("publish_time") @db.Time(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  person   Person                @relation(fields: [personId], references: [id], onDelete: Restrict)
  targets  AnnouncementTarget[]
  sections AnnouncementSection[]

  @@map("announcements")
}

model AnnouncementTarget {
  id             Int                  @id @default(autoincrement())
  announcementId Int                  @map("announcement_id")
  audienceTarget AnnouncementAudience @map("audience_target")
  deletedAt      DateTime?            @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, audienceTarget])
  @@map("announcement_targets")
}

model AnnouncementSection {
  id             Int       @id @default(autoincrement())
  announcementId Int       @map("announcement_id")
  sectionId      Int       @map("section_id")
  classId        Int       @map("class_id")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  section      Section      @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Restrict)

  @@unique([announcementId, sectionId])
  @@map("announcement_sections")
}

model Activity {
  id        Int       @id @default(autoincrement())
  title     String    @db.VarChar(255)
  content   String    @db.Text
  date      DateTime  @db.Date
  hits      Int       @default(0)
  image     String    @db.Text
  personId  Int       @map("person_id")
  yearId    Int?      @map("year_id")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)
  year   Year?  @relation(fields: [yearId], references: [id], onDelete: Restrict)

  @@map("activities")
}

model SchoolDetail {
  id        Int       @id @default(autoincrement())
  schoolId  Int       @unique @map("school_id")
  telephone String    @db.VarChar(255)
  phone     String    @db.VarChar(255)
  fax       String    @db.VarChar(255)
  address   String    @db.VarChar(255)
  email     String    @db.VarChar(255)
  website   String    @db.VarChar(255)
  about     String    @db.Text
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_details")
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

model AttendanceReason {
  id        Int       @id @default(autoincrement())
  title     String    @db.VarChar(255)
  personId  Int       @map("person_id")
  status    Boolean   @default(true)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  person            Person             @relation(fields: [personId], references: [id], onDelete: Restrict)
  attendanceDetails AttendanceDetail[]

  @@map("attendance_reasons")
}

model Attendance {
  id        Int       @id @default(autoincrement())
  date      DateTime  @db.Date
  sectionId Int       @map("section_id")
  status    Boolean   @default(true)
  personId  Int       @map("person_id")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  section Section            @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  person  Person             @relation(fields: [personId], references: [id], onDelete: Restrict)
