  gradeTypeId Int       @map("grade_type_id")
  maxGrade    Decimal   @map("max_grade") @db.Decimal(7, 2)
  publishDate DateTime? @map("publish_date") @db.Timestamptz(6)
  personId    Int       @map("person_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  school    School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  section   Section       @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  gradeType GradeType     @relation(fields: [gradeTypeId], references: [id], onDelete: Restrict)
  person    Person        @relation(fields: [personId], references: [id], onDelete: Restrict)
