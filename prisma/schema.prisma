  agendaDate    DateTime  @map("agenda_date") @db.Date
  time          String    @db.VarChar(10)
  personId      Int       @map("person_id")
  courseId      Int       @map("course_id")
  imageLink     String    @map("image_link") @db.Text
  fileLink      String    @map("file_link") @db.Text
  publishedDate DateTime  @map("published_date") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  status        Int       @default(1)
