  status      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  class     Class      @relation(fields: [classId], references: [id], onDelete: Restrict)
  year      Year       @relation(fields: [yearId], references: [id], onDelete: Restrict)
  gradeType GradeType  @relation(fields: [gradeTypeId], references: [id], onDelete: Restrict)
  person    Person     @relation(fields: [personId], references: [id], onDelete: Restrict)
